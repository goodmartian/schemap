// The same shop as shop.sql; both importers must agree on tables, columns, keys and references.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "catalog", "sales"]
}

/// People who can sign in
model User {
  id        String    @id @db.Uuid
  /// Sign-in address, unique
  email     String    @unique @db.VarChar(320)
  fullName  String?   @map("full_name")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  sessions  Session[]
  orders    Order[]

  @@map("users")
  @@schema("auth")
}

model Session {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("auth")
}

model Category {
  id       Int        @id
  /// Empty for a top-level category
  parentId Int?       @map("parent_id")
  name     String
  parent   Category?  @relation("Tree", fields: [parentId], references: [id])
  children Category[] @relation("Tree")
  products Product[]

  @@map("categories")
  @@schema("catalog")
}

model Product {
  id         String         @id @db.Uuid
  categoryId Int            @map("category_id")
  title      String
  price      Decimal        @db.Decimal(12, 2)
  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  items      OrderItem[]

  @@map("products")
  @@schema("catalog")
}

model ProductImage {
  productId String  @map("product_id") @db.Uuid
  position  Int
  url       String
  product   Product @relation(fields: [productId], references: [id])

  @@id([productId, position])
  @@map("product_images")
  @@schema("catalog")
}

/// One checkout
model Order {
  id        String      @id @db.Uuid
  buyerId   String      @map("buyer_id") @db.Uuid
  status    String      @default("new")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  buyer     User        @relation(fields: [buyerId], references: [id])
  items     OrderItem[]
  payments  Payment[]

  @@map("orders")
  @@schema("sales")
}

model OrderItem {
  orderId   String   @map("order_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  refunds   Refund[]

  @@id([orderId, productId])
  @@map("order_items")
  @@schema("sales")
}

model Payment {
  id      String    @id @db.Uuid
  orderId String    @map("order_id") @db.Uuid
  amount  Decimal   @db.Decimal(12, 2)
  paidAt  DateTime? @map("paid_at") @db.Timestamptz
  order   Order     @relation(fields: [orderId], references: [id])

  @@map("payments")
  @@schema("sales")
}

model Refund {
  id        String    @id @db.Uuid
  orderId   String    @map("order_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  note      String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  item      OrderItem @relation(fields: [orderId, productId], references: [orderId, productId])

  @@map("refunds")
  @@schema("sales")
}
